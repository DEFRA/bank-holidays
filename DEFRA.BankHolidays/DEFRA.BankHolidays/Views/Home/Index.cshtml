<div class="jumbotron">
    <h1>Bank Holiday Service</h1>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Refresh Holiday Data</h2>
        <p>
            Clear all existing holiday data in repository and replace with update from Gov.Uk.
            Data will be available as a web service.
        </p>
        <p><button id="refresh" class="btn btn-primary" data-loading-text="<i class='fa fa-circle-o-notch fa-spin'></i> Refreshing...">Refresh</button></p>
    </div>
    <div class="col-md-4">
        <h2>API</h2>
        <p>
            View API end point details and examples.  External applications can access bank holiday information from all of the United Kingdom in Json format.
        </p>
        <p>@Html.ActionLink("Details", "Index", "Help", new { area = "" }, new { @class = "btn btn-primary" })</p>
    </div>
</div>

<div class="row" id="confirmation" style="display:none">
    <div class="alert alert-dismissible alert-info col-md-2" style="position: fixed; bottom: 10px; left: 10px;">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        Holiday data refreshed.
    </div>
</div>

<div class="row" id="warning" style="display:none">
    <div class="alert alert-dismissible alert-danger col-md-2" style="position: fixed; bottom: 10px; left: 10px;">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <p id="reason"></p>
    </div>
</div>

<script>
    $('#refresh').click(function () {
        $('#refresh').button('loading');
        $.ajax({
            url: "https://www.gov.uk/bank-holidays.json"
        }).success(function (response) {            

            var data = JSON.stringify(response);

            $.ajax({
                type: "POST",
                url: "/Home/Refresh",                
                data: { data: data },
                cache: false,
                success: function (response) {
                    if (response = "Ok") {
                        $('#confirmation').fadeIn(2000);
                    }
                    else {
                        $('#reason').html(response);
                        $('#warning').fadeIn(2000);
                    }
                },
                complete: function () {
                    $('#refresh').button('reset');
                }
            });
        });
    });
</script>